{
  "name": "mcp-woodpecker",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for Woodpecker CI with comprehensive API tool support for pipeline management, secrets, registries, and more",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "mcp-woodpecker": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "woodpecker-ci",
    "ci-cd",
    "automation",
    "api",
    "pipeline",
    "devops"
  ],
  "author": {
    "name": "BerryJ",
    "url": "https://github.com/berryj85"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/berryj85/mcp-woodpecker.git"
  },
  "homepage": "https://github.com/berryj85/mcp-woodpecker#readme",
  "bugs": {
    "url": "https://github.com/berryj85/mcp-woodpecker/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
